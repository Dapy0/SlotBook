{
  "name": "@slotbook/backend",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch --watch src src/index.ts",
    "dev:debug": "tsx --inspect-brk=9229 src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/dropAll.ts && drizzle-kit migrate && npm run db:seed"
  },
  "dependencies": {
    "@fastify/caching": "^9.0.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/etag": "^6.2.0",
    "@fastify/jwt": "^10.2.1",
    "@slotbook/shared": "*",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.11.2",
    "fastify-type-provider-zod": "^7.0.0",
    "geoip-lite": "^2.0.3",
    "pg": "^8.22.0",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9.39.5",
    "eslint-plugin-drizzle": "^0.2.3",
    "globals": "^14.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10"
  }
}
