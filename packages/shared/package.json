{
  "name": "@slotbook/shared",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "exports": {
    ".": "./src/index.ts",
    "./codecs": "./src/codecs.ts",
    "./auth": "./src/auth.ts",
    "./user": "./src/user.ts",
    "./facility": "./src/facility.ts",
    "./facilitySchedule": "./src/facilitySchedule.ts",
    "./service": "./src/service.ts",
    "./staffMembers": "./src/staffMembers.ts",
    "./staffServices": "./src/staffServices.ts",
    "./staffSchedule": "./src/staffSchedule.ts",
    "./bookings": "./src/bookings.ts",
    "./availability": "./src/availability.ts",
    "./reviews": "./src/reviews.ts",
    "./errors": "./src/errors.ts"
  },
  "devDependencies": {
    "zod": "^4.4.3",
    "eslint": "^9.39.5",
    "eslint-plugin-zod": "^4.12.1",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10",
    "typescript": "5.9.3"
  }
}
